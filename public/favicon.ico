<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64">
  <defs>
    <linearGradient id="goldGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#FDE68A"/>
      <stop offset="35%" stop-color="#F59E0B"/>
      <stop offset="70%" stop-color="#D97706"/>
      <stop offset="100%" stop-color="#78350F"/>
    </linearGradient>
    <linearGradient id="darkBg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#182032"/>
      <stop offset="100%" stop-color="#050811"/>
    </linearGradient>
    <filter id="goldGlow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="2" stdDeviation="2" flood-color="#F59E0B" flood-opacity="0.4"/>
    </filter>
  </defs>

  <!-- Background Squircle with luxury border -->
  <rect x="2" y="2" width="60" height="60" rx="16" fill="url(#darkBg)" stroke="url(#goldGrad)" stroke-width="2.5"/>

  <!-- Subtle Film Sprocket Holes along the sides -->
  <rect x="6" y="8" width="4" height="6" rx="1.5" fill="#F59E0B" opacity="0.3"/>
  <rect x="6" y="20" width="4" height="6" rx="1.5" fill="#F59E0B" opacity="0.3"/>
  <rect x="6" y="32" width="4" height="6" rx="1.5" fill="#F59E0B" opacity="0.3"/>
  <rect x="6" y="44" width="4" height="6" rx="1.5" fill="#F59E0B" opacity="0.3"/>

  <rect x="54" y="8" width="4" height="6" rx="1.5" fill="#F59E0B" opacity="0.3"/>
  <rect x="54" y="20" width="4" height="6" rx="1.5" fill="#F59E0B" opacity="0.3"/>
  <rect x="54" y="32" width="4" height="6" rx="1.5" fill="#F59E0B" opacity="0.3"/>
  <rect x="54" y="44" width="4" height="6" rx="1.5" fill="#F59E0B" opacity="0.3"/>

  <!-- CineVerse Crown / "C" + Cinema Play Emblem -->
  <!-- Bold Stylized "C" Emblem in Golden Gradient -->
  <path d="M 40 18 
           C 34 14, 22 15, 18 24 
           C 14 33, 16 42, 22 47 
           C 28 51, 38 50, 42 45 
           L 37 40 
           C 34 43, 27 44, 24 41 
           C 20 37, 19 30, 23 24 
           C 26 19, 34 18, 38 22 
           Z" 
        fill="url(#goldGrad)" 
        filter="url(#goldGlow)"/>

  <!-- Dynamic Golden Triangle (Play / Projector Beam) inside C -->
  <polygon points="31,25 45,32 31,39" fill="url(#goldGrad)" filter="url(#goldGlow)"/>

  <!-- Tiny Green & White Pakistan Crescent-Star Touch -->
  <circle cx="48" cy="16" r="3.5" fill="#10B981" stroke="#FDE68A" stroke-width="0.8"/>
  <polygon points="48,13.5 49,15.5 51,15.5 49.5,16.8 50,18.8 48,17.5 46,18.8 46.5,16.8 45,15.5 47,15.5" fill="#FFFFFF"/>
</svg>
